<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Notifique</RootNamespace>
    <PackageId>Notifique</PackageId>
    <Version>0.2.1</Version>
    <Authors>Notifique</Authors>
    <Description>SDK oficial Notifique para .NET — WhatsApp, SMS, Email, Push e templates</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/notifique-dev/notifique-sdk</RepositoryUrl>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <EmbeddedResource Include="..\..\operations.json" Link="operations.json" />
  </ItemGroup>
</Project>
