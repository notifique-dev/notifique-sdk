        "openapi-typescript": "^7.13.0",
        "supertest": "^7.2.2",
        "ts-jest": "^29.4.6",
        "ts-node": "^10.9.2"
    },
    "overrides": {
        "glob": "^13.0.0",
        "inflight": "npm:lru-cache@^10.0.0"
