{
    "name": "notifique-monorepo",
    "private": true,
    "description": "Notifique SDK Monorepo",
    "workspaces": [
        "packages/core",
        "packages/sdk-node",
        "packages/sdk-python",
        "packages/sdk-java",
        "packages/sdk-go",
        "packages/sdk-php",
        "packages/sdk-elixir",
        "packages/sdk-dotnet"
